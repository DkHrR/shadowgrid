pragma language_version 0.23;

import CompactStandardLibrary;

export struct PlayerPrivateState {
  game_id: Uint<64>,
  player_id: Bytes<32>,
  x: Uint<32>,
  y: Uint<32>,
  health: Uint<32>,
  nonce: Uint<64>,
  salt: Bytes<32>
}

export ledger commitments: Map<Bytes<32>, Bytes<32>>;
export ledger position_x: Map<Bytes<32>, Uint<32>>;
export ledger position_y: Map<Bytes<32>, Uint<32>>;

witness localState(): PlayerPrivateState;

export circuit verify_move(
  x_new: Uint<32>,
  y_new: Uint<32>,
  new_salt: Bytes<32>
): [] {
  assert(x_new == x_new, "Ok");
}

export circuit register(
  game_id: Uint<64>, 
  player_id: Bytes<32>, 
  x: Uint<32>, 
  y: Uint<32>, 
  health: Uint<32>, 
  salt: Bytes<32>
): [] {
  assert(game_id == game_id, "Ok");
}

