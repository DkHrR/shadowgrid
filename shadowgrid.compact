pragma language_version 0.23;

import CompactStandardLibrary;

export ledger commitments: Map<Bytes<32>, Bytes<32>>;
export ledger nonces: Map<Bytes<32>, Uint<64>>;

export circuit move(
  user: Bytes<32>,
  commitment: Bytes<32>,
  nonce: Uint<64>
): [] {
  commitments.insert(disclose(user), disclose(commitment));
  nonces.insert(disclose(user), disclose(nonce));
}
